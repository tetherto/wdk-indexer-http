{
  "name": "@tetherto/wdk-indexer-http",
  "version": "1.0.3",
  "description": "HTTP client for the Indexer API from WDK (Wallet Development Kit) by Tether, providing blockchain token transfers and balances.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./bare": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#abort-controller": {
      "bare": "bare-abort-controller",
      "default": "./lib/abort-controller.js"
    },
    "#fetch": {
      "bare": "bare-fetch",
      "default": "./lib/fetch.js"
    },
    "#url": {
      "bare": "bare-url",
      "default": "./lib/url.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "standard",
    "test": "brittle test/*.js test/*.mjs",
    "test:bare": "brittle-bare test/*.js test/*.mjs",
    "test:integration": "brittle test/integration/*.js",
    "test:integration:bare": "brittle-bare test/integration/*.js",
    "test:types": "npx -y -p typescript@5 tsc -p test/types && npx -y -p typescript@5 tsc -p test/types/tsconfig.bundler.json"
  },
  "keywords": [
    "tether",
    "wdk",
    "indexer",
    "usdt",
    "xaut",
    "usat",
    "btc",
    "blockchain",
    "ethereum",
    "arbitrum",
    "avalanche",
    "polygon",
    "tron",
    "ton",
    "bitcoin",
    "spark",
    "token",
    "transfers",
    "balance",
    "api",
    "sdk",
    "bare"
  ],
  "author": "Tether Operations Limited",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "bare-abort-controller": "^1.1.2",
    "bare-fetch": "^3.4.0",
    "bare-url": "^2.5.4"
  },
  "peerDependenciesMeta": {
    "bare-abort-controller": {
      "optional": true
    },
    "bare-fetch": {
      "optional": true
    },
    "bare-url": {
      "optional": true
    }
  },
  "devDependencies": {
    "bare-abort-controller": "^1.1.2",
    "bare-fetch": "^3.4.0",
    "bare-url": "^2.5.4",
    "brittle": "^3.19.1",
    "standard": "^17.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/wdk-indexer-http.git"
  },
  "bugs": {
    "url": "https://github.com/tetherto/wdk-indexer-http/issues"
  },
  "homepage": "https://docs.wdk.tether.io/tools/indexer-api/"
}
